{
  "name": "pantro-tenant",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "android:prebuild": "expo prebuild --platform android --clean",
    "sign:android": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-signing.ps1",
    "repair:gradle-cache": "powershell -ExecutionPolicy Bypass -File scripts/repair-gradle-transform-cache.ps1",
    "build:aab": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1 -Target aab",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1 -Target apk",
    "build:android": "npm run sign:android && npm run build:aab && npm run build:apk",
    "verify:16kb": "powershell -ExecutionPolicy Bypass -File scripts/verify-16kb.ps1",
    "ota:bundle": "npx expo export --platform android --output-dir dist",
    "ota:publish": "node scripts/publish-ota.js",
    "build:android:eas": "eas build --platform android --profile production",
    "submit:android:eas": "eas submit --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.7.2",
    "expo": "^54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8", 
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "lucide-react-native": "^0.563.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.1.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
