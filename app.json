{
  "expo": {
    "name": "Pantro Tenant",
    "slug": "pantro-tenant",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pantro-tenant",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pantro.tenant",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "Allow Pantro to access contacts for emergency contact selection",
        "NSCameraUsageDescription": "Allow Pantro to access camera for document uploads and profile photos",
        "NSPhotoLibraryUsageDescription": "Allow Pantro to access photo library for document uploads",
        "NSLocationWhenInUseUsageDescription": "Allow Pantro to access location for property address verification"
      }
    },
    "android": {
      "package": "com.pantro.tenant",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "androidStatusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff",
        "translucent": false
      },
      "androidNavigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "https://stayverse-backend-zyl7.onrender.com/api"
    }
  }
}
